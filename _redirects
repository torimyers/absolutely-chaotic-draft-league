# Pages Functions serve /api/*. The catch-all below would otherwise rewrite
# those requests to index.html before they ever reach a Function; _routes.json
# scopes Function invocation to the same prefix.
/api/*  /api/:splat  200

# Handle SPA routing - all routes go to index.html
/*    /index.html   200

# Redirect www to non-www
https://www.texasperfect.win/*  https://texasperfect.win/:splat  301!